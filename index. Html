<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>PAS - Register</title>
  <!-- Bootstrap Icons CDN for icons -->
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: #f7f9fc;
      display: flex;
      justify-content: center;
      min-height: 100vh;
      color: #333;
    }

    .mobile-frame {
      width: 100%;
      max-width: 430px;
      min-height: 100vh;
      background: #ffffff;
      position: relative;
      padding: 16px 20px 80px 20px;
      box-shadow: 0 0 20px rgba(0,0,0,0.05);
    }

    /* Top Navigation */
    .top-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
    }

    .lang-badge {
      border: 1.5px solid #222;
      border-radius: 4px;
      padding: 2px 6px;
      font-weight: 700;
      font-size: 14px;
      letter-spacing: 0.5px;
      color: #111;
    }

    .top-actions {
      display: flex;
      gap: 16px;
      align-items: center;
    }

    .top-actions i {
      font-size: 24px;
      color: #1a73e8;
      cursor: pointer;
    }

    /* Logo Section */
    .logo-container {
      text-align: center;
      margin: 15px 0 25px 0;
    }

    .logo-text {
      font-size: 58px;
      font-weight: 900;
      font-style: italic;
      color: #2b7de9;
      letter-spacing: 2px;
      position: relative;
      display: inline-block;
      text-shadow: 0 4px 12px rgba(43, 125, 233, 0.25);
    }

    .logo-wave {
      position: relative;
      margin-top: -12px;
      height: 10px;
      background: linear-gradient(90deg, transparent, #2b7de9, transparent);
      border-radius: 50%;
      filter: blur(1px);
    }

    /* Guide Banner */
    .guide-banner {
      background: linear-gradient(135deg, #f0f7ff 0%, #e6f0fa 100%);
      border: 1px solid #d4e5f7;
      border-radius: 14px;
      padding: 12px 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 22px;
      cursor: pointer;
      box-shadow: 0 2px 6px rgba(43, 125, 233, 0.04);
    }

    .guide-icon {
      font-size: 26px;
      line-height: 1;
    }

    .guide-content {
      flex: 1;
    }

    .guide-title {
      font-size: 16px;
      font-weight: 700;
      color: #0b3b7a;
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .guide-sub {
      font-size: 11.5px;
      color: #5b738e;
      margin-top: 2px;
    }

    .guide-arrow {
      color: #1a73e8;
      font-size: 20px;
    }

    /* Input Fields */
    .input-box {
      background: #edf2f9;
      border-radius: 8px;
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 16px;
      margin-bottom: 15px;
      position: relative;
    }

    .input-box .prefix {
      font-size: 16px;
      font-weight: 700;
      color: #1a73e8;
      margin-right: 12px;
    }

    .input-box input {
      border: none;
      background: transparent;
      outline: none;
      width: 100%;
      font-size: 15px;
      color: #2b3b4c;
      font-weight: 500;
    }

    .input-box input::placeholder {
      color: #9cb1c9;
      font-weight: 400;
    }

    .input-box .icon-right {
      color: #9cb1c9;
      font-size: 19px;
      cursor: pointer;
      margin-left: 8px;
    }

    .input-box.readonly-code input {
      font-weight: 700;
      color: #222;
    }

    /* Submit Button */
    .btn-register {
      width: 100%;
      height: 52px;
      background: #0076ff;
      border: none;
      border-radius: 8px;
      color: #fff;
      font-size: 16px;
      font-weight: 600;
      margin-top: 10px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(0, 118, 255, 0.3);
      transition: background 0.2s;
    }

    .btn-register:active {
      background: #005ecb;
    }

    /* Bottom Login Link */
    .bottom-link {
      text-align: center;
      margin-top: 18px;
      font-size: 13.5px;
      font-weight: 600;
      color: #0076ff;
      cursor: pointer;
    }

    /* Floating Chat Button */
    .floating-chat {
      position: fixed;
      bottom: 90px;
      right: 20px;
      width: 64px;
      height: 64px;
      background: radial-gradient(circle at 30% 30%, #ffe066, #e5a100);
      border-radius: 50%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      box-shadow: 0 4px 14px rgba(229, 161, 0, 0.45);
      cursor: pointer;
    }

    .floating-chat i {
      font-size: 20px;
      color: #1e7e34;
      line-height: 1;
    }

    .floating-chat span {
      font-size: 11px;
      font-weight: 700;
      color: #4a3400;
      margin-top: 3px;
    }
  </style>
</head>
<body>

  <div class="mobile-frame">
    <!-- Top Bar -->
    <div class="top-bar">
      <div class="lang-badge">EN</div>
      <div class="top-actions">
        <i class="bi bi-headphones"></i>
        <i class="bi bi-chat-dots-fill"></i>
      </div>
    </div>

    <!-- PAS Logo -->
    <div class="logo-container">
      <div class="logo-text">PAS</div>
      <div class="logo-wave"></div>
    </div>

    <!-- Guide Banner -->
    <div class="guide-banner">
      <div class="guide-icon">📖</div>
      <div class="guide-content">
        <div class="guide-title">How to Register Guide</div>
        <div class="guide-sub">Tap to view step-by-step instructions</div>
      </div>
      <i class="bi bi-question-circle-fill guide-arrow"></i>
    </div>

    <!-- Form Inputs -->
    <form id="regForm" onsubmit="event.preventDefault();">
      <!-- Phone Number -->
      <div class="input-box">
        <span class="prefix">+91</span>
        <input type="tel" placeholder="Please enter your phone number" maxlength="10">
      </div>

      <!-- Password -->
      <div class="input-box">
        <input type="password" id="pass1" placeholder="Please enter your password">
        <i class="bi bi-eye-slash icon-right" onclick="togglePass('pass1', this)"></i>
      </div>

      <!-- Confirm Password -->
      <div class="input-box">
        <input type="password" id="pass2" placeholder="Please confirm your password">
        <i class="bi bi-eye-slash icon-right" onclick="togglePass('pass2', this)"></i>
      </div>

      <!-- 6-digit Withdrawal Password -->
      <div class="input-box">
        <input type="password" id="withdrawPass" placeholder="Please enter your 6-digit withdrawal passwo..." maxlength="6">
        <i class="bi bi-eye-slash icon-right" onclick="togglePass('withdrawPass', this)"></i>
      </div>

      <!-- Invitation Code (Pre-filled) -->
      <div class="input-box readonly-code">
        <input type="text" id="inviteId" value="7275337" readonly>
      </div>

      <!-- Register Button -->
      <button type="submit" class="btn-register">Register now</button>
    </form>

    <!-- Login Link -->
    <div class="bottom-link">
      Already have an account? Login&gt;&gt;
    </div>

    <!-- Floating Customer Service Chat -->
    <div class="floating-chat">
      <i class="bi bi-chat-dots-fill"></i>
      <span>Chat</span>
    </div>
  </div>

  <script>
    // Password hide/show toggle logic
    function togglePass(id, el) {
      const field = document.getElementById(id);
      if (field.type === 'password') {
        field.type = 'text';
        el.className = 'bi bi-eye icon-right';
      } else {
        field.type = 'password';
        el.className = 'bi bi-eye-slash icon-right';
      }
    }

    // URL से ऑटोमैटिक referral code लोड करने का फंक्शन
    window.addEventListener('DOMContentLoaded', () => {
      try {
        const hash = window.location.hash;
        if (hash.includes('query=')) {
          const queryStr = decodeURIComponent(hash.split('query=')[1]);
          const parsed = JSON.parse(queryStr);
          if (parsed.id) {
            document.getElementById('inviteId').value = parsed.id;
          }
        }
      } catch (e) {
        console.log("Default referral used");
      }
    });
  </script>

</body>
</html>
